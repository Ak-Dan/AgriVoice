{
  "name": "cropguard-ai",
  "version": "1.0.0",
  "private": "true",
  "description": "A WhatsApp/USSD-first crop advisory system with a public Week 2 demo console for model-backed crop diagnosis.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm run start -w backend",
    "start:frontend": "npm run start -w frontend",
    "rag:ingest": "npm run rag:ingest -w backend",
    "setup:model": "node scripts/download-model.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waynemwashuma/cropguard-ai.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/waynemwashuma/cropguard-ai/issues"
  },
  "homepage": "https://github.com/waynemwashuma/cropguard-ai#readme",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "concurrently": "^9.2.1",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "react-router-dom": "^7.16.0"
  }
}
